# EduEvent Manager — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/edueventdb

# JWT secret key — change this to a long random string in production
JWT_SECRET=eduevent_super_secret_key_change_in_prod

# Server port
PORT=5000

# Nodemailer / SMTP Email Settings
# If not provided, Nodemailer will fallback to Ethereal test account in dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="EduEvent Manager" <noreply@eduevent.com>

# Pre-event reminder scheduler (24h + 2h before each event)
# REMINDERS_ENABLED=false disables the scheduler entirely
REMINDERS_ENABLED=true
# Cron expression controlling how often the scheduler checks for due reminders
REMINDER_CRON_SCHEDULE=*/5 * * * *

